# Базовые настройки — работает из коробки
DATABASE_URL="file:./dev.db"
AUTH_SECRET="juriist-dev-secret-do-not-use-in-production-abc123xyz"
AUTH_TRUST_HOST=true

# Google OAuth (опционально — раскомментируйте и заполните)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI-провайдер (приоритет: Gemini → Groq → Anthropic → демо)
# Достаточно одного ключа — система выберет первый доступный

# Gemini (бесплатный) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (бесплатный, быстрый) — https://console.groq.com/keys
# GROQ_API_KEY=

# Anthropic (платный, премиум) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
