# Базовые настройки — PostgreSQL
# Для локальной разработки с Neon (бесплатный уровень):
# 1. Создайте проект на https://console.neon.tech
# 2. Скопируйте Connection String
# Пример для локальной разработки с PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/juriist"
#
# Или используйте Neon напрямую (все окружения):
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.neon.tech/neondb"
AUTH_SECRET="juriist-dev-secret-do-not-use-in-production-abc123xyz"
AUTH_TRUST_HOST=true

# Google OAuth (опционально — раскомментируйте и заполните)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI-провайдер (приоритет: Gemini → Groq → Anthropic → демо)
# Достаточно одного ключа — система выберет первый доступный

# Gemini (бесплатный) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (бесплатный, быстрый) — https://console.groq.com/keys
# Вставьте ваш ключ ниже (раскомментируйте строку):
# GROQ_API_KEY=ваш-ключ-здесь

# Anthropic (платный, премиум) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
