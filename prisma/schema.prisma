generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                 String                @id @default(cuid())
  name               String?
  email              String                @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  // Deprecated — kept for backward compatibility during the rollout.
  // The source of truth for plan is now Organization.plan; this field
  // becomes the seed for the user's auto-created personal workspace.
  plan               String                @default("FREE")

  // Currently active workspace. Set lazily on first authenticated request
  // (see ensureActiveOrg in src/lib/org.ts) so existing users transparently
  // get a "Personal workspace" with all their existing data attached.
  activeOrgId        String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  accounts           Account[]
  sessions           Session[]
  documents          Document[]
  generatedDocuments GeneratedDocument[]
  chats              Chat[]
  counterpartyChecks CounterpartyCheck[]
  documentVersions   DocumentVersion[]
  versionComparisons VersionComparison[]
  legalReferences    LegalReference[]
  aiUsage            AiUsage[]
  memberships        Membership[]
  passwordResetTokens PasswordResetToken[]
}

// Single-use, time-limited password-reset token. Only the SHA-256 hash is
// stored; the plaintext value lives only in the email recipient's inbox.
// On consume the row is marked used (not deleted) so a stolen email
// arriving twice can't be replayed even within the validity window.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// A workspace shared by 1..N users. Plans, quotas, and document visibility
// are scoped here. Every user always has at least one Organization (their
// personal workspace, auto-created on first login).
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("FREE")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        Membership[]
  invites            Invite[]
  documents          Document[]
  generatedDocuments GeneratedDocument[]
  chats              Chat[]
  counterpartyChecks CounterpartyCheck[]
  aiUsage            AiUsage[]
}

// User <-> Organization join with role. A user can belong to many orgs;
// an org has many members. The (userId, orgId) pair is unique — a user
// has exactly one role per org.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  // "OWNER" | "ADMIN" | "MEMBER". OWNER may delete the org and transfer
  // ownership; ADMIN may invite/remove members; MEMBER may only use it.
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

// Shareable invitation link. token is high-entropy random; recipient pastes
// the resulting URL or clicks it. expiresAt caps the validity window.
// acceptedAt becomes non-null on acceptance and the invite is then a no-op.
// Email is optional in this MVP — invites work as a plain shareable link.
model Invite {
  id         String   @id @default(cuid())
  orgId      String
  email      String?
  role       String   @default("MEMBER")
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  acceptedAt DateTime?
  createdBy  String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id        String    @id @default(cuid())
  userId    String
  // Workspace that owns this document. Nullable during the rollout — the
  // first time an existing user signs in, ensureActiveOrg() back-fills this
  // for all of their docs in one transaction. New uploads always set it.
  orgId     String?
  fileName  String
  fileSize  Int
  rawText   String
  mimeType  String?
  blobUrl   String?
  blobKey   String?
  analysis  Analysis?
  chunks    DocumentChunk[]
  createdAt DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String
  chunkIndex  Int
  text        String

  // pgvector embedding for semantic search across the user's own contracts.
  // 1024-dim matches Voyage voyage-3-large (same model as LegalKnowledge).
  // Nullable so a Document can exist before its chunks are embedded.
  embedding   Unsupported("vector(1024)")?

  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model Analysis {
  id         String   @id @default(cuid())
  documentId String   @unique
  score      Int
  summary    String
  risks      String
  metadata   String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model GeneratedDocument {
  id         String   @id @default(cuid())
  userId     String
  orgId      String?
  templateId String
  name       String
  content    String
  formData   Json
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@index([userId])
  @@index([orgId])
  @@index([templateId])
}

model DocumentVersion {
  id              String   @id @default(cuid())
  generatedDocId  String
  versionNumber   Int
  title           String
  content         String
  formData        Json
  changesSummary  String?

  createdAt       DateTime @default(now())
  createdBy       String?

  generatedDoc    GeneratedDocument @relation(fields: [generatedDocId], references: [id], onDelete: Cascade)
  creator         User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  v1Comparisons   VersionComparison[] @relation("v1")
  v2Comparisons   VersionComparison[] @relation("v2")

  @@unique([generatedDocId, versionNumber])
  @@index([generatedDocId])
}

model VersionComparison {
  id        String   @id @default(cuid())
  v1Id      String
  v2Id      String
  userId    String

  diffs     String

  createdAt DateTime @default(now())

  v1   DocumentVersion @relation("v1", fields: [v1Id], references: [id], onDelete: Cascade)
  v2   DocumentVersion @relation("v2", fields: [v2Id], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([v1Id, v2Id, userId])
  @@index([userId])
}

model Chat {
  id        String        @id @default(cuid())
  userId    String
  orgId     String?
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model LegalKnowledge {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String   // "statute" | "article" | "clause"
  title         String
  shortTitle    String
  fullText      String
  commentary    String?
  practiceNotes String?
  relatedCodes  String   @default("[]") // JSON array as string

  tags          String   @default("[]") // JSON array as string
  searchVector  String

  // pgvector embedding (1024-dim, voyage-3-large). Nullable so rows can
  // exist before being indexed. Filled by /api/admin/embed-legal.
  // Prisma can't represent vector types natively yet, so we use Unsupported
  // and query through raw SQL in src/lib/legal-search.ts.
  embedding     Unsupported("vector(1024)")?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  references    LegalReference[]

  @@index([code])
}

model LegalReference {
  id        String   @id @default(cuid())
  userId    String
  knownId   String

  note      String?

  createdAt DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledge LegalKnowledge  @relation(fields: [knownId], references: [id], onDelete: Cascade)

  @@unique([userId, knownId])
  @@index([userId])
}

model CounterpartyProfile {
  id                  String   @id @default(cuid())
  inn                 String   @unique
  name                String
  organizationType    String?  // "ООО" | "ИП" | "АО" etc.

  // From ЕГРЮЛ
  registrationDate    DateTime?
  address             String?
  okved               String?
  capitalSize         Int?
  statusCode          String?

  // From court registries
  activeLawsuits      Int      @default(0)
  completedLawsuits   Int      @default(0)
  lossesCount         Int      @default(0)

  // Debts and payments
  debtFound           Boolean  @default(false)
  debtAmount          BigInt?
  debtSources         String   @default("") // JSON array as string

  // Risk calculation
  riskScore           Int      @default(50)
  riskLevel           String   @default("medium")
  riskFactors         String   @default("") // JSON array as string

  lastUpdated         DateTime @updatedAt
  dataSource          String   @default("egrul")

  createdAt           DateTime @default(now())

  checks              CounterpartyCheck[]

  @@index([inn])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  orgId        String?
  feature      String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  cachedTokens Int      @default(0)
  latencyMs    Int

  createdAt    DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, feature])
  @@index([orgId, createdAt])
  @@index([orgId, feature])
}

model CounterpartyCheck {
  id           String   @id @default(cuid())
  userId       String
  orgId        String?
  inn          String

  notes        String?

  createdAt    DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profile      CounterpartyProfile @relation(fields: [inn], references: [inn], onDelete: Cascade)

  // Dedup stays per-user. We considered moving to (orgId, inn) so a re-check
  // by another team member would update the existing row, but `prisma db
  // push` flags adding the new constraint as a "potential data loss" event
  // (false positive — orgId is nullable and NULL≠NULL in Postgres) and
  // refuses without --accept-data-loss. We don't want that flag in the
  // Vercel build script — it would mask real data-loss changes in future
  // migrations. Per-user history is also arguably better for audit
  // ("Иванов проверил INN X, Петров проверил его же позже").
  @@unique([userId, inn])
  @@index([userId])
  @@index([orgId])
  @@index([inn])
}
