# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# ═══ Обязательные ═══

# PostgreSQL (Neon / Supabase / Railway / свой сервер)
# Пример: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/juriist"

# Секрет для подписи JWT-сессий (сгенерируйте: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ═══ AI-провайдер (нужен хотя бы один ключ) ═══
# Приоритет: Anthropic → Gemini → Groq → демо-режим

# Anthropic (платный, премиум, prompt caching) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Gemini (бесплатный) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (бесплатный, быстрый) — https://console.groq.com/keys
# GROQ_API_KEY=

# ═══ Rate limit / Redis (рекомендуется на проде) ═══
# Без этих переменных rate-limit работает на in-memory Map,
# что в Vercel serverless практически бессмысленно.
# Заведите бесплатный Redis на https://console.upstash.com
# (тариф Free: 10 000 команд/день — хватит на старте)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ═══ Хранилище оригиналов документов (рекомендуется) ═══
# Без этой переменной анализ работает, но оригиналы загруженных
# файлов не сохраняются — нельзя скачать их позже / проанализировать
# повторно.
# Vercel → Project → Storage → Create Blob Store → копируете
# токен из Quickstart (Hobby tier: 1GB бесплатно)
# BLOB_READ_WRITE_TOKEN=

# ═══ OCR для скан-PDF (рекомендуется для b2b) ═══
# 60-70% входящих коммерческих договоров приходят сканами.
# Без этих переменных скан-PDF возвращает 422 OCR_NOT_AVAILABLE.
# Требуется аккаунт Yandex Cloud:
#   1. https://console.cloud.yandex.ru → создать каталог (folder)
#   2. Service Accounts → Create → role: ai.vision.user
#   3. У SA → API Keys → Create → копируете ключ
# Бесплатный лимит: 1000 страниц/мес, далее ~₽0.18/страница.
# OCR доступен только на тарифах PRO и BUSINESS (квота из plans.ts).
# Документы любого размера до 10 МБ обрабатываются автоматически
# (multi-page split на страницы ≤ 1 МБ). Лимит: 30 страниц/документ.
# YANDEX_OCR_API_KEY=
# YANDEX_OCR_FOLDER_ID=

# ═══ Sentry — отслеживание ошибок (рекомендуется на проде) ═══
# Без этих переменных приложение работает; ошибки только в console.
# С ними — все 5xx, AI-провайдер failures и unhandled exceptions
# уходят в Sentry с тегами op (analyze / generate / chat / ocr / etc).
# Создайте проект на https://sentry.io (Free tier: 5k events/мес).
# DSN — это write-only ID проекта, не секрет.
# SENTRY_DSN=                  # серверная сторона
# NEXT_PUBLIC_SENTRY_DSN=      # клиентская (можно тот же)
# SENTRY_ORG=                  # для source map upload в build
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=           # только в CI, для source maps

# ═══ Embeddings + RAG (опционально, но сильно улучшает чат и /legal) ═══
# Без этой переменной чат работает как раньше (без цитат), а /legal
# показывает только keyword-поиск. С ней:
#   • Чат RAG-обогащается: топ-5 релевантных статей подмешиваются в
#     системный промпт, AI цитирует их по [N]-нумерации
#   • На /legal появляется переключатель «По смыслу» — векторный поиск
#     возвращает релевантные статьи даже если слова в запросе не совпадают
#   • Embeddings лежат в LegalKnowledge.embedding (vector(1024))
#
# 1. ВКЛЮЧИ pgvector в Neon: SQL Editor → CREATE EXTENSION IF NOT EXISTS vector;
# 2. Зарегистрируйся на https://www.voyageai.com (Anthropic-recommended,
#    отлично работает с русским). Free tier: 200M токенов/мес.
# 3. Получи API key и вставь сюда.
# 4. После деплоя сгенерируй embeddings один раз:
#    curl -X POST -H "x-admin-key: <ADMIN_SEED_KEY>" \
#         https://your-domain/api/admin/embed-legal
# VOYAGE_API_KEY=

# ═══ Контрагенты — реальные источники (опционально) ═══
# DaData (выше) уже даёт ЕГРЮЛ. Для тарифа Бизнес нужны реальные
# КАД (суды) и ФССП (долги). Сейчас они на моках — провайдеры
# в src/lib/counterparty/providers/{kad,fssp}.ts ждут реальных
# реализаций.
#
# Варианты подключения (по убыванию цены/полноты):
#   • Контур.Фокус: ~₽40-80k/мес, всё в одном (КАД+ФССП+банкротства+
#     санкции). https://focus.kontur.ru — KONTUR_FOCUS_KEY
#   • api-fns.ru: ~₽3000/мес, только КАД и ФССП через ФНС API.
#     https://api-fns.ru — API_FNS_KEY
#   • ФССП публичный API: бесплатно, 100 req/день, только долги.
#     https://api-ip.fssp.gov.ru — FSSP_AUTH_KEY
# KONTUR_FOCUS_KEY=
# API_FNS_KEY=
# FSSP_AUTH_KEY=

# ═══ Платежи (ЮKassa) ═══
# Без этих переменных /api/billing/checkout вернёт 503 и кнопки в /billing
# покажут «Платежи временно недоступны».
#
# Подключение:
#   1. Зарегистрируйтесь как ИП/ООО на https://yookassa.ru
#   2. Подтвердите магазин (требуется ИНН + ОГРН/ОГРНИП + расчётный счёт)
#   3. Настройки → API → создайте секретный ключ → скопируйте оба значения
#   4. Настройки → Уведомления HTTP → добавьте URL:
#        https://<ваш-домен>/api/billing/webhook
#      События: payment.succeeded, payment.canceled, payment.waiting_for_capture
#   5. (Опционально) Защита: настройте allowlist IP-адресов на стороне
#      платформы — список адресов ЮKassa в их документации.
#
# Тестовый магазин (для разработки): получите тестовые credentials в
# консоли ЮKassa → раздел «Тестовый магазин».
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# ═══ Транзакционные письма (рекомендуется) ═══
# Без этих переменных приложение работает: вместо реальной отправки
# в логи пишется warning "[email:noop] would send …", регистрация и
# приглашения не падают, но письма не доходят.
#
# С Resend:
#   1. Зарегистрируйся на https://resend.com (Free: 3k писем/мес, 100/день)
#   2. Resend → Domains → Add Domain → подтверди DNS-записи (SPF/DKIM/DMARC)
#   3. Resend → API Keys → Create → Sending access → копируешь ключ
# RESEND_API_KEY=
#
# Адрес From-поля. По умолчанию — "ЮрИИст <no-reply@juriist.ru>".
# Пока домен не подтверждён, используй sandbox-адрес Resend:
# RESEND_FROM_ADDRESS="ЮрИИст <onboarding@resend.dev>"

# ═══ Аналитика (PostHog) ═══
# Отслеживает события: signup, analysis_completed, document_generated,
# document_refined, payment_succeeded, member_invited и т.д. PII не
# отправляется — только User.id/orgId и категориальные поля.
# Без этих переменных приложение работает; события просто никуда не уходят.
#
# 1. Зарегистрируйся на https://eu.posthog.com (EU host для лучшего
#    соответствия 152-ФЗ; cloud.posthog.com — US host).
# 2. Settings → Project → Project API Key (phc_...) — НЕ personal key.
# 3. Скопируй сюда + в Vercel env (Production + Preview).
# POSTHOG_API_KEY=
#
# Хост (по умолчанию EU):
# POSTHOG_HOST=https://eu.i.posthog.com
#
# Клиентский ключ — тот же phc_..., НО с префиксом NEXT_PUBLIC_, чтобы
# попал в браузерный бандл.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ═══ Админ-панель ═══
# Список User.id (НЕ email) через запятую — кому виден /admin и доступны
# административные действия (продление триала, ручная смена плана, и т.д.).
# User.id — это cuid, его можно посмотреть в Neon SQL Editor:
#   SELECT id, email FROM "User" WHERE email = 'you@yourdomain.com';
# Без этой переменной /admin показывает 403 для всех.
# ADMIN_USER_IDS=cuid1,cuid2

# ═══ Опциональные ═══

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Тип: OAuth 2.0 Client ID → Web application
# Redirect URI: https://yourdomain.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
