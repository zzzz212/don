# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Базовые настройки
DATABASE_URL="file:./dev.db"
AUTH_SECRET="сгенерируйте-случайную-строку"
AUTH_TRUST_HOST=true

# AI-провайдер (приоритет: Gemini → Groq → Anthropic → демо)
# Достаточно одного ключа — система выберет первый доступный

# Gemini (бесплатный) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (бесплатный, быстрый) — https://console.groq.com/keys
# GROQ_API_KEY=

# Anthropic (платный, премиум) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Google OAuth (опционально — вход через Google)
# Создайте проект: https://console.cloud.google.com/apis/credentials
# Тип: OAuth 2.0 Client ID → Web application
# Redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
