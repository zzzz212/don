# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# ═══ Обязательные ═══

# PostgreSQL (Neon / Supabase / Railway / свой сервер)
# Пример: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/juriist"

# Секрет для подписи JWT-сессий (сгенерируйте: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ═══ AI-провайдер (нужен хотя бы один ключ) ═══
# Приоритет: Anthropic → Gemini → Groq → демо-режим

# Anthropic (платный, премиум, prompt caching) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Gemini (бесплатный) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Groq (бесплатный, быстрый) — https://console.groq.com/keys
# GROQ_API_KEY=

# ═══ Rate limit / Redis (рекомендуется на проде) ═══
# Без этих переменных rate-limit работает на in-memory Map,
# что в Vercel serverless практически бессмысленно.
# Заведите бесплатный Redis на https://console.upstash.com
# (тариф Free: 10 000 команд/день — хватит на старте)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ═══ Хранилище оригиналов документов (рекомендуется) ═══
# Без этой переменной анализ работает, но оригиналы загруженных
# файлов не сохраняются — нельзя скачать их позже / проанализировать
# повторно.
# Vercel → Project → Storage → Create Blob Store → копируете
# токен из Quickstart (Hobby tier: 1GB бесплатно)
# BLOB_READ_WRITE_TOKEN=

# ═══ OCR для скан-PDF (рекомендуется для b2b) ═══
# 60-70% входящих коммерческих договоров приходят сканами.
# Без этих переменных скан-PDF возвращает 422 OCR_NOT_AVAILABLE.
# Требуется аккаунт Yandex Cloud:
#   1. https://console.cloud.yandex.ru → создать каталог (folder)
#   2. Service Accounts → Create → role: ai.vision.user
#   3. У SA → API Keys → Create → копируете ключ
# Бесплатный лимит: 1000 страниц/мес, далее ~₽0.18/страница.
# OCR доступен только на тарифах PRO и BUSINESS (квота из plans.ts).
# YANDEX_OCR_API_KEY=
# YANDEX_OCR_FOLDER_ID=

# ═══ Опциональные ═══

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Тип: OAuth 2.0 Client ID → Web application
# Redirect URI: https://yourdomain.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
